<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title><%= pageTitle %></title>
  <style>
    body { font-family: sans-serif; padding: 20px; }
    .user-info { border: 1px solid #ccc; padding: 15px; border-radius: 8px; }
  </style>
</head>
<body>
  <!-- <h1><%= pageTitle %></h1> -->

  <% if (userData) { %>
    <div class="user-info">
      <h2>Información del Usuario</h2>
      <p style="color:red"><strong>User:</strong> <%= userData.user %></p>
      <!-- <p><strong>Token:</strong> <%= userData.token %></p> -->
      LOG-OUT  ----> <a href="logout">*** LOG-OUT ****</a>.
    </div>
  <% } else { %>
    <p>No se encontraron datos del usuario en las cookies.</p>
  <% } %>
  
</body>
</html>
